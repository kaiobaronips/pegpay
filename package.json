{
  "name": "pegpay",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo da PegPay Soluções Digitais — fintech brasileira de crédito.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pegpay/site",
    "build": "npm run build -w @pegpay/site",
    "lint": "npm run lint -w @pegpay/site",
    "preview": "npm run preview -w @pegpay/site",
    "build:all": "npm run build --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
