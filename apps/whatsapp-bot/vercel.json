{
  "version": 2,
  "builds": [
    { "src": "api/health.ts", "use": "@vercel/node" },
    { "src": "api/webhooks/wati.ts", "use": "@vercel/node" },
    { "src": "api/notifications/proposal-status.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/api/health.ts" },
    { "src": "/api/webhooks/wati", "dest": "/api/webhooks/wati.ts" },
    { "src": "/api/notifications/proposal-status", "dest": "/api/notifications/proposal-status.ts" }
  ]
}
