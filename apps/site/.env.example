# Google Analytics 4 — Measurement ID da propriedade GA4 (formato G-XXXXXXXXXX).
# Sem esse ID, nenhum script do Google Analytics é carregado, mesmo com
# consentimento do usuário — o carregador em src/lib/analytics.ts fica no-op.
VITE_GA_MEASUREMENT_ID=

# Meta Pixel — ID numérico do pixel criado no Gerenciador de Eventos da Meta.
# Sem esse ID, o Meta Pixel nunca é injetado.
VITE_META_PIXEL_ID=
